# ----- LLM -----
# LiteLLM reads the provider key from the environment.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Default model id. Keep the LiteLLM provider prefix.
# Example: gemini/gemini-3.5-flash-lite
PYAGENT_MODEL=

# ----- Event log -----
# Overrides the default runs/host-<timestamp>.jsonl path for the host CLI
PYAGENT_LOG_PATH=

# ----- MCP / workspace -----
# Module the host CLI launches as the MCP server (default: pyagent.server)
PYAGENT_MCP_MODULE=
# Root for the file tools exposed by the MCP server (default: ./workspace)
WORKSPACE_ROOT=

# ----- Web search -----
TAVILY_API_KEY=

# ----- Tracing (optional) -----
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ----- Sandbox (optional) -----
# Deno must be on PATH for execute_python; no path override is supported.